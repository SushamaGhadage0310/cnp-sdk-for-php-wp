{
    "name": "vantiv/cnp-payments-sdk",
    "type": "library",
    "description": "The Vantiv eCommerce PHP SDK is a PHP implementation of the [Vantiv eCommerce](https://docs.worldpay.com/apis/cnpapi). XML API. This SDK was created to make it as easy as possible to connect process your payments with Vantiv eCommerce",
    "keywords": ["vantiv","sdk","ecommerce","payments", "cnp"],
    "homepage": "https://docs.worldpay.com/apis/cnpapi",
    "license": "MIT",
    "authors": [
        {
            "name": "Vantiv eCommerce SDK",
            "homepage": "https://docs.worldpay.com/apis/cnpapi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.6.0",
        "phpseclib/phpseclib": "~3.0.35"
    },
    "require-dev": {
        "phpunit/phpunit": "3.7.*"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload":{
     	"psr-0":{"cnp\\sdk" : "."},
        "classmap": ["cnp/"]
    }
}
